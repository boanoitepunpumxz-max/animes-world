# ============================================================
# ANIMES WORLD — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# ============================================================

# Servidor
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Banco de Dados PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/animesworld
DB_HOST=localhost
DB_PORT=5432
DB_NAME=animesworld
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# Autenticação
JWT_SECRET=seu_jwt_secret_muito_seguro_aqui_minimo_32_chars
JWT_EXPIRES_IN=7d
SESSION_SECRET=seu_session_secret_muito_seguro_aqui
COOKIE_SECRET=seu_cookie_secret_aqui

# E-mail (recuperação de senha, notificações)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu@email.com
SMTP_PASSWORD=sua_senha_de_app
SMTP_FROM=ANIMES WORLD <noreply@animesworld.com>

# AniList API (gratuita, sem chave necessária — mas coloque se tiver)
ANILIST_API_URL=https://graphql.anilist.co

# ============================================================
# ORIGEM DOS EPISÓDIOS (configure depois conforme sua fonte)
# ============================================================
EPISODE_SOURCE=manual
# Opções: manual | embed | hls | custom

VIDEO_BASE_URL=
# URL base dos seus vídeos (ex: https://cdn.seusite.com/videos)

STREAM_SOURCE=
# URL do seu servidor de stream HLS (ex: https://stream.seusite.com)

EMBED_ALLOWED_DOMAINS=
# Domínios permitidos para embeds (separados por vírgula)

# Admin padrão (criado no seed)
ADMIN_EMAIL=admin@animesworld.com
ADMIN_PASSWORD=Admin@123456

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# AnFireAPI (importador de episódios — opcional)
ANFIRE_API_URL=http://localhost:4000
ANFIRE_API_KEY=sua_chave_anfire
ANFIRE_BASE_URL=https://animefire.plus
ANFIRE_RATE_LIMIT=1200

# Anibunker (importador de episódios — opcional)
ANIBUNKER_ENABLED=true
ANIBUNKER_BASE_URL=https://www.anibunker.com
ANIBUNKER_TIMEOUT=15000
ANIBUNKER_RATE_LIMIT=1500
